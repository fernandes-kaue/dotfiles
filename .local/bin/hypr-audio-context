#!/bin/sh
# Choose real PipeWire defaults at runtime; no device name is hard-coded.
set -eu

choose_device() {
  section=$1
  label=$2
  devices=$(wpctl status | awk -v section="$section" '
    $0 ~ section { in_section=1; next }
    in_section && /^[[:space:]]*[│├└]/ {
      if (match($0, /[0-9]+\./)) {
        id=substr($0, RSTART, RLENGTH-1)
        line=$0
        sub(/^.*[0-9]+\. /, "", line)
        print id "\t" line
      }
    }
    in_section && $0 ~ /Sources:|Sinks:/ && $0 !~ section { exit }
  ')
  selected=$(printf '%s\n' "$devices" | rofi -dmenu -i -p "$label")
  id=$(printf '%s' "$selected" | cut -f1)
  [ -n "$id" ] && wpctl set-default "$id"
}

action=$(printf '%s\n' 'Saída padrão' 'Microfone padrão' 'Alternar microfone' | rofi -dmenu -i -p 'Áudio')
case "$action" in
  'Saída padrão') choose_device 'Sinks:' 'Saída' ;;
  'Microfone padrão') choose_device 'Sources:' 'Microfone' ;;
  'Alternar microfone') wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
esac
