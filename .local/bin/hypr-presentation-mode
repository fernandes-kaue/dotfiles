#!/bin/sh
# Reduce visible desktop chrome while presenting; DND is already enabled globally.
set -eu

state_file="${XDG_RUNTIME_DIR:-/tmp}/hypr-presentation-mode"
if [ -f "$state_file" ]; then
  rm -f "$state_file"
  serpantinum msg toggle autohide || true
  exec hypr-focus-mode
fi

printf '%s\n' enabled > "$state_file"
serpantinum msg toggle autohide || true
exec hypr-focus-mode
