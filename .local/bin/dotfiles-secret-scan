#!/usr/bin/env bash
set -euo pipefail

git_cmd=(/bin/git --git-dir="${HOME}/.dotfiles" --work-tree="${HOME}")
mode="${1:-staged}"

case "$mode" in
  staged)
    mapfile -t files < <("${git_cmd[@]}" diff --cached --name-only --diff-filter=ACMRTUXB)
    ;;
  all)
    mapfile -t files < <("${git_cmd[@]}" ls-files)
    ;;
  -h|--help)
    cat <<'EOF'
Usage: dotfiles-secret-scan [staged|all]

Defaults to scanning staged files in the bare dotfiles repo.
Use "all" to scan every tracked file.
EOF
    exit 0
    ;;
  *)
    echo "Unknown mode: $mode" >&2
    exit 1
    ;;
esac

if (( ${#files[@]} == 0 )); then
  echo "No files to scan."
  exit 0
fi

pattern='BEGIN [A-Z ]*PRIVATE KEY|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]+|sk-[A-Za-z0-9]{20,}|AIza[0-9A-Za-z\-_]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|access_token|refresh_token|password\s*=|passwd\s*=|token\s*=|secret\s*=|authorization:|mongodb(\+srv)?:\/\/[^[:space:]]+:[^[:space:]]+@|postgres(ql)?:\/\/[^[:space:]]+:[^[:space:]]+@'
paths=()
for file in "${files[@]}"; do
  paths+=("${HOME}/${file}")
done

tmp_out="$(mktemp)"
trap 'rm -f "$tmp_out"' EXIT

if rg --no-heading --line-number --color=never -I -e "$pattern" "${paths[@]}" >"$tmp_out" 2>/dev/null; then
  cat "$tmp_out"
  echo
  echo "Potential secrets found."
  exit 1
fi

echo "No secret patterns found in ${mode} files."
