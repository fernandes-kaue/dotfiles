#!/usr/bin/env bash
set -euo pipefail

since_input="${1:-2h}"

if [[ "$since_input" =~ ^([0-9]+)([mhd])$ ]]; then
  amount="${BASH_REMATCH[1]}"
  unit="${BASH_REMATCH[2]}"

  case "$unit" in
    m) since="${amount} minutes ago" ;;
    h) since="${amount} hours ago" ;;
    d) since="${amount} days ago" ;;
  esac
else
  since="$since_input"
fi

section() {
  printf '\n== %s ==\n' "$1"
}

section "System Errors (${since})"
journalctl --since "${since}" -p err..alert --no-pager || true

section "System Warnings (${since})"
journalctl --since "${since}" -p warning --no-pager | tail -n 120 || true

section "User Errors (${since})"
journalctl --user --since "${since}" -p err..alert --no-pager || true

section "User Warnings (${since})"
journalctl --user --since "${since}" -p warning --no-pager | tail -n 120 || true
