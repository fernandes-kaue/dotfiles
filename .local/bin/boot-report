#!/usr/bin/env bash
set -euo pipefail

section() {
  printf '\n== %s ==\n' "$1"
}

section "Boot Time"
systemd-analyze

section "Slowest Units"
systemd-analyze blame | head -n 20

section "Critical Chain"
systemd-analyze critical-chain

section "Failed Units"
systemctl --failed --no-legend || true
echo
systemctl --user --failed --no-legend || true

section "Boot Errors"
journalctl -b -p 3 --no-pager | tail -n 50 || true
